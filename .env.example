# ---- Runtime ----
# Mock allows the full upload/parse/demo flow with no API key.
APP_ENV=development
MODEL_PROVIDER=mock
MODEL_NAME=mock-research-copilot
# 仅视觉任务使用；Mock/纯文本供应商可留空。
MODEL_VISION_MODEL=
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_TOKENS=4096
MODEL_RETRY_COUNT=2
FAST_MODEL_NAME=
STANDARD_MODEL_NAME=
DEEP_MODEL_NAME=
FALLBACK_MODEL_NAME=

# DeepSeek 官方 API 示例（取消下列注释并替换上方同名配置）：
# MODEL_PROVIDER=deepseek
# MODEL_NAME=deepseek-v4-flash
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.deepseek.com
# FALLBACK_MODEL_NAME=deepseek-v4-pro

# Ollama 本地文本 + 论文页面视觉模型示例（Windows + Docker）：
# MODEL_PROVIDER=ollama
# MODEL_NAME=qwen2.5:7b
# MODEL_VISION_MODEL=qwen2.5vl:3b
# MODEL_API_KEY=
# MODEL_BASE_URL=http://host.docker.internal:11434
# FALLBACK_MODEL_NAME=qwen2.5:3b
# 如果后端不在 Docker 中而是直接运行，请改用 http://localhost:11434

# ---- Personal paper library retrieval (backend-only) ----
# bge-m3 only generates local semantic vectors; it does not answer questions.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_TIMEOUT_SECONDS=120
KNOWLEDGE_CHUNK_SIZE=1600
KNOWLEDGE_CHUNK_OVERLAP=180

# ---- Storage and database (backend-only) ----
DATABASE_URL=sqlite:///./data/energy_copilot.db
PAPER_STORAGE_PATH=./data/papers
MAX_UPLOAD_MB=50

# ---- Budget ----
DAILY_BUDGET_CNY=10
MONTHLY_BUDGET_CNY=100
PAPER_BUDGET_CNY=2

# ---- Personal schedule ----
DAILY_TASK_TIME=08:00
USER_TIMEZONE=Asia/Shanghai
ENABLE_WEEKEND_DIGEST=true

# ---- Academic paper sources (backend-only) ----
# Public metadata sources are enabled by default; Semantic Scholar is opt-in.
OPENALEX_ENABLED=true
OPENALEX_BASE_URL=https://api.openalex.org
CROSSREF_ENABLED=true
CROSSREF_BASE_URL=https://api.crossref.org
# Optional contact address for Crossref polite-pool identification.
CROSSREF_MAILTO=
ARXIV_ENABLED=true
ARXIV_BASE_URL=https://export.arxiv.org/api
SEMANTIC_SCHOLAR_ENABLED=false
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org
# Optional backend secret. Never expose this value to the browser.
SEMANTIC_SCHOLAR_API_KEY=
PAPER_SOURCE_TIMEOUT_SECONDS=15
PAPER_DOWNLOAD_TIMEOUT_SECONDS=30
PAPER_DOWNLOAD_MAX_MB=50

# ---- Email (reserved for Phase 4) ----
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# ---- Frontend server-side proxy ----
BACKEND_API_URL=http://backend:8000
# Optional Docker build registry override for networks where npmjs.org times out.
# NPM_REGISTRY=https://registry.npmjs.org
