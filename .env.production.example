APP_DOMAIN=research.example.com
APP_USERNAME=researcher
# Generate with: docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext 'replace-me'
# In Compose env files, double every $ in the resulting bcrypt hash as $$.
APP_PASSWORD_HASH=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MODEL_PROVIDER=mock
MODEL_NAME=mock-research-copilot
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
STORAGE_BACKEND=local
# For S3, set STORAGE_BACKEND=s3 and fill the backend-only values below.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_RETENTION=7
BACKUP_INTERVAL_HOURS=24
# Optional existing local model directory; the app never downloads it automatically.
WHISPER_MODEL_PATH=/app/models/faster-whisper-small
